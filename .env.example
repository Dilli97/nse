# Database
# If running with Docker Compose: host is 'db' on port 5432
# If running locally on Windows: host is 'localhost' (port 5432 or 5433)
POSTGRES_USER=nseapp
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=nse_analysis
DATABASE_URL=postgresql://nseapp:changeme_use_strong_password@db:5432/nse_analysis
# Local Windows alternative:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5433/nse_analysis

# Backend & Security
SECRET_KEY=changeme_generate_random_key_openssl_rand_hex_32
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# API Security (Optional, set AUTH_ENABLED=true to enforce API keys)
AUTH_ENABLED=false
APP_API_KEY=

# Data Providers
DEFAULT_PROVIDER=yahoo
# Broker Integration (Optional: Zerodha, Fyers, Upstox)
# BROKER_PROVIDER=fyers
# BROKER_API_KEY=
# BROKER_API_SECRET=

# Market Timing & Timezone
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Background Worker Settings
QUOTE_REFRESH_MINUTES=5
CANDLE_UPDATE_HOUR=18
FUNDAMENTALS_UPDATE_DAY=saturday

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Ollama for Local AI Research Reports
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

